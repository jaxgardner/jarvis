.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.db
*.db-wal
*.db-shm

# Xcode. The .p8 is a credential and belongs beside the database, outside the
# repo — this is a backstop in case one ever lands here by accident.
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/
*.p8

# Same backstop for the Google refresh token, which is a long-lived credential
# for reading your mail. It is written beside the database, not here.
google_token.json
helpers/tccread/tccread
