# Copy to .env and fill in. .env is gitignored and should be chmod 600.

# Fast path — Messages API key from console.anthropic.com (NOT the Claude Code subscription)
ANTHROPIC_API_KEY=sk-ant-...

# Shared bearer token. This is the *enrollment* credential: the
# iOS app presents it once to POST /devices and uses its own token afterwards.
# The Shortcut still uses it directly, so it stays valid.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JARVIS_TOKEN=

# Which push backends to fan out to: ntfy, apns, or both.
# The APNs cutover is meant to run as "ntfy,apns" for two weeks before ntfy
# is dropped — a silent push regression is the failure that hurts most.
PUSH_BACKENDS=ntfy

# ntfy push. The topic name IS the authentication — make it long and random.
# Generate with: python -c "import secrets;print('jarvis-'+secrets.token_urlsafe(24))"
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# APNs. Key ID / Team ID / bundle ID are not secrets; the .p8 is.
# The .p8 is downloadable exactly once from the Developer portal and never
# expires. Keep it outside the repo and chmod 600.
APNS_KEY_PATH=~/Library/Application Support/jarvis/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.jarvis
# prod for TestFlight and App Store builds; sandbox only for Xcode debug builds.
APNS_ENV=prod

DEFAULT_TZ=America/Denver

# Local voice. The weights are ~310 MB and are NOT in the repo — see
# ios/README.md for the download. With them absent the server answers 503 on
# /speech and the phone falls back to Apple's synthesizer, which is a working
# configuration, just a worse-sounding one.
# Voices are Kokoro's. The espeak-ng language is derived from the prefix, so
# there is no second setting to keep in sync: af_/am_ are American, bf_/bm_
# British. Anything else in the weights file (Japanese, Chinese, European)
# is refused rather than mispronounced.
# British: bm_george, bm_lewis, bm_daniel, bm_fable, bf_emma, bf_isabella,
#          bf_alice, bf_lily.  American: af_bella, af_heart, am_michael, ...
TTS_VOICE=af_bella
TTS_SPEED=1.0

# Kept outside the repo so the database is never committed and survives a re-clone.
JARVIS_DB=~/Library/Application Support/jarvis/jarvis.db

# Google ingestion. A "Desktop app" OAuth client from
# console.cloud.google.com → APIs & Services → Credentials.
#
# SET THE CONSENT SCREEN TO "In production" BEFORE AUTHORIZING. Left in
# "Testing", Google issues refresh tokens that expire after 7 days with no
# warning — the assistant ingests perfectly for a week and then silently
# stops.
#
# The refresh token itself is NOT stored here — it goes to
# ~/Library/Application Support/jarvis/google_token.json, mode 600, written by
#     uv run python -m ingest.google_auth --authorize
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deep path (Claude Code headless). The worker runs as a LaunchDaemon,
# which cannot read the login keychain where `claude` normally keeps its
# OAuth credentials. Generate a long-lived token with `claude setup-token`
# and paste it here. Bills against the subscription, not API credits.
CLAUDE_CODE_OAUTH_TOKEN=
